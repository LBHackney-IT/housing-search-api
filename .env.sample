# Sample environment file.
#
# The API does **not** read `.env` itself. `docker compose` only interpolates the variables that
# docker-compose.yml references with `${...}` — for this repository that is `LBHPACKAGESTOKEN` (plus
# `SONAR_TOKEN` for the test image). The variables under "Runtime" below are read by the API from its
# process environment and are **not** picked up from this file; docker-compose.yml hardcodes its own values
# for the container. Export them (or add them to the compose service) if you need to override them.

# --- Build (read from .env by docker compose) --------------------------------
# Personal access token with read:packages on the LBHackney-IT GitHub Packages feed.
# Required by `docker compose build` (the Hackney.* packages are not on nuget.org).
LBHPACKAGESTOKEN=your-github-personal-access-token-here

# --- Runtime (NOT read from .env — export these) ------------------------------
# The compose stack supplies http://test-elasticsearch:9200 to the container.
# Defaults to http://localhost:9200 when unset.
ELASTICSEARCH_DOMAIN_URL=http://localhost:9200

# Optional: set to "true" when connecting to a remote Elasticsearch instance. This also requires the URL to
# use HTTPS and relaxes certificate validation (see V1/Infrastructure/Extensions/ElasticSearchExtensions.cs).
# USING_REMOTE_DB=false
